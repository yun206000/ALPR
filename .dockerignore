# 只把程式碼與 environment.yml 送進 build context；
# 權重、資料、輸出都用 volume 掛載
.git
.gitignore
**/__pycache__
*.pyc
*.pyo
.pytest_cache
.mypy_cache
*.egg-info
.env
docker/.env
*.log
*.md

models/
data/
outputs/
runs/
dist/
tests/
htmlcov/
.coverage
coverage.xml
*.pt
*.pth
*.ckpt

# 例外：bundle target（映像內含權重）需要的檔案
!models/yolo/finetuned/best.pt
!models/yolo/pretrained/license_plate_detector.pt
!models/parseq/finetuned/best.ckpt
!MODEL_CARD.md
