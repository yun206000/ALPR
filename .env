# LPR Pipeline 環境變數設定
# 複製為 .env 並依需求修改

# ---- Detector ----
# DETECTOR_MODEL_VARIANT=rf_detr_base
# DETECTOR_WEIGHTS_PATH=models/rfdetr.pth
DETECTOR_CONFIDENCE_THRESHOLD=0.5
DETECTOR_NMS_IOU_THRESHOLD=0.5
DETECTOR_INPUT_SIZE=640
DETECTOR_DEVICE=cpu          # cuda | mps | cpu

# ---- Recognizer (PARSeq) ----
RECOGNIZER_MODEL_VARIANT=parseq
RECOGNIZER_WEIGHTS_PATH=models/parseq.pt
RECOGNIZER_CHARSET=0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ-
RECOGNIZER_MAX_LABEL_LENGTH=25
RECOGNIZER_DEVICE=cpu
RECOGNIZER_CROP_PADDING=0.05

# ---- Pipeline ----
OUTPUT_DIR=outputs
LOG_LEVEL=INFO

# ---- API ----
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
