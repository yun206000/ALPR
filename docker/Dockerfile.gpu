# GPU 版本 Dockerfile（基於 CUDA 12.1）
FROM nvidia/cuda:12.4.0-cudnn-runtime-ubuntu22.04 AS runtime

LABEL description="LPR Pipeline GPU — RF-DETR + PARSeq"

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.11 \
    python3-pip \
    python3.11-dev \
    git \
    libglib2.0-0 \
    libgl1 \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

RUN ln -sf python3.11 /usr/bin/python && ln -sf pip3 /usr/bin/pip

RUN groupadd -r lpr && useradd -r -g lpr lpr

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir torch torchvision --index-url https://download.pytorch.org/whl/cu121 \
    && pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir \
        git+https://github.com/roboflow/rf-detr.git \
        git+https://github.com/baudm/parseq.git

COPY src/ ./src/
COPY main.py .

RUN mkdir -p models outputs data/samples && chown -R lpr:lpr /app

# 複製 entrypoint 腳本
COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENV PYTHONUNBUFFERED=1
ENV DETECTOR_DEVICE=cuda
ENV RECOGNIZER_DEVICE=cuda

VOLUME ["/app/models", "/app/outputs", "/app/data"]
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=90s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1

ENTRYPOINT ["/entrypoint.sh"]
CMD ["python", "main.py", "--serve", "--host", "0.0.0.0", "--port", "8000"]
